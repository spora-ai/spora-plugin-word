{
    "name": "spora-ai/spora-plugin-office",
    "description": "Markdown <-> Office documents for Spora agents — Word (DOCX/ODT/RTF) and PowerPoint (PPTX) producers, a MIME refiner, media-library themes, and bundled skills.",
    "type": "spora-plugin",
    "license": "MIT",
    "keywords": ["spora", "plugin", "office", "word", "docx", "odt", "rtf", "pptx", "powerpoint", "markdown", "media-derivatives", "document-generation"],
    "require": {
        "php": "^8.4.1",
        "ext-zip": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "spora-ai/spora-core": ">=0.30.0 <2.0.0",
        "markdown-office/markdown-word": "^0.3",
        "markdown-office/markdown-presentation": "^0.3",
        "symfony/yaml": "^7.4 || ^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0"
    },
    "suggest": {
        "spora-ai/spora-plugin-media-archive": "Browse, filter, and download the DOCX and PPTX files this plugin renders."
    },
    "autoload": {
        "psr-4": {
            "Spora\\Plugins\\Office\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spora\\Plugins\\Office\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:parallel": "pest --parallel --processes=auto --max-batch-size=50",
        "test:coverage": "XDEBUG_MODE=coverage pest --parallel --processes=auto --max-batch-size=50 --coverage-filter=src --coverage-clover=coverage/clover.xml --coverage-cobertura=coverage/cobertura.xml --coverage-html=coverage/html --coverage-text=coverage/summary.txt",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "lint": "php-cs-fixer fix --dry-run --diff --no-interaction",
        "format": "php-cs-fixer fix --no-interaction"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "spora-ai/installer": true,
            "cweagans/composer-patches": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
